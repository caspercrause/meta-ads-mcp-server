# --- Read server (server.py) and local reporting ---
# Read-scoped token (the read system user). The legacy name
# FACEBOOK_ACCESS_TOKEN still works as a fallback.
FACEBOOK_ACCESS_TOKEN_R=your_read_token_here
# Optional override; the code defaults to the tested version
# FACEBOOK_API_VERSION=v26.0

# --- Write server (write_server.py) only ---
# ads_management token of the WRITE system user. No fallback by design:
# only the ad accounts assigned to that system user can ever be changed.
FACEBOOK_ACCESS_TOKEN_W=your_write_token_here
# Approval secret, required before any change can be applied.
# Preferred: TOTP one-time codes. Generate the secret OUTSIDE any AI
# conversation and add the same value to your authenticator app:
#   python -c "import pyotp; print(pyotp.random_base32())"
# META_WRITE_TOTP_SECRET=base32secret
# Fallback where TOTP is not configured:
# META_WRITE_PASSWORD=choose_a_long_password
# Optional guard overrides (defaults shown):
# META_WRITE_MAX_FACTOR=5
# META_WRITE_MAX_DAILY_BUDGET=10000
# META_WRITE_MAX_LIFETIME_BUDGET=100000
# Team mode: one secret per operator, 'name:SECRET' pairs, comma separated.
# Every applied batch then records approved_by=<name>; revoke an operator
# by deleting their entry.
# META_WRITE_TOTP_SECRETS=alice:BASE32ONE,bob:BASE32TWO
